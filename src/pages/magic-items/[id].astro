---
import Layout from '../../layouts/Layout.astro';
import MagicItemsCatalog from '../../components/magicItems/MagicItemsCatalog.astro';
import { magicItems } from '../../data/magicItems';
export function getStaticPaths() {
  return magicItems.map(item => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
---
<Layout title={`${item.name} — Магические предметы`}>
  <MagicItemsCatalog initialItemId={item.id} />
</Layout>
